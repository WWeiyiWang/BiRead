{
  "name": "biread-zotero",
  "version": "0.1.0-beta",
  "description": "Bilingual PDF Reader for Zotero",
  "config": {
    "addonName": "BiRead — Bilingual PDF Reader for Zotero",
    "addonID": "biread@wweiyiwang.github.io",
    "addonRef": "biread",
    "prefsPrefix": "extensions.zotero.BiRead",
    "addonInstance": "BiRead"
  },
  "main": "src/index.ts",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && node build-local.mjs",
    "release": "echo Release automation is disabled pending manual review.",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "lint": "prettier --write . && eslint . --fix",
    "lint:check": "prettier --check . && eslint .",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save",
    "test:bilingual": "node --test test/bilingual-core.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WWeiyiWang/BiRead.git"
  },
  "author": "BiRead: WWeiyiWang; upstream zotero-pdf-translate: windingwind and contributors",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/WWeiyiWang/BiRead/issues"
  },
  "homepage": "https://github.com/WWeiyiWang/BiRead#readme",
  "dependencies": {
    "franc": "^6.2.0",
    "iso639-js": "^1.1.3",
    "jsencrypt": "^3.5.0",
    "katex": "^0.16.25",
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.3"
  }
}
